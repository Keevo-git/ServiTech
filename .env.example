SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASS=replace-with-your-database-password
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:password@POOLER_HOST:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_AUTH_ENABLED=0
SERVITECH_DB_ENFORCE_RLS=0
APP_DEBUG=0
SESSION_LIFETIME_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=1800
REMEMBER_ME_LIFETIME_SECONDS=2592000
SERVITECH_PRIVATE_UPLOAD_DIR=/home/your-hostinger-user/ServiTech_Uploads
SERVITECH_REQUIRE_PRIVATE_UPLOAD_ROOT=1
SERVITECH_ARCHIVE_CLOSED_DAYS=60
SERVITECH_TEMP_UPLOAD_RETENTION_HOURS=24
SERVITECH_CLOSED_UPLOAD_RETENTION_DAYS=30
SERVITECH_NOTIFICATION_SOFT_DELETED_DAYS=30
SERVITECH_NOTIFICATION_READ_DAYS=45
SERVITECH_NOTIFICATION_ARCHIVED_UNREAD_DAYS=60
SERVITECH_SOFT_DELETE_PURGE_DAYS=30
SERVITECH_LOGIN_ATTEMPT_RETENTION_DAYS=1
APP_PUBLIC_URL=https://servitech.store
SERVITECH_CONTACT_EMAIL=theservitech.store@gmail.com
SERVITECH_CONTACT_PHONE=+63 912 393 4321
SERVITECH_CONTACT_FACEBOOK_URL=https://www.facebook.com/JCstorebagbaguin
SERVITECH_CONTACT_FACEBOOK_LABEL=JC Store
SERVITECH_GCASH_ACCOUNT_NAME=
SERVITECH_GCASH_ACCOUNT_NUMBER=

AUTH_CONSENT_VERSION=2026-06-12
AUTH_REQUIRE_EMAIL_VERIFICATION=1
AUTH_PROFILE_REBIND_SECONDS=300
AUTH_REQUIRE_ADMIN_MFA=1
AUTH_ALLOW_ADMIN_MFA_ENROLLMENT=0
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=10
AUTH_LOGIN_THROTTLE_SECRET=replace-with-a-long-random-secret

# PHP application mail only. Configure Supabase Auth Custom SMTP separately
# in the Supabase Dashboard for signup verification and recovery delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=REPLACE_WITH_NEW_GOOGLE_ACCOUNT@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=REPLACE_WITH_NEW_GOOGLE_ACCOUNT@gmail.com
SMTP_FROM_NAME=ServiTech
SMTP_REPLY_TO=REPLACE_WITH_NEW_GOOGLE_ACCOUNT@gmail.com
SMTP_DEBUG=false
