DirectoryIndex index.php index.html
Options -Indexes

<IfModule php_module>
  php_value upload_max_filesize 25M
  php_value post_max_size 105M
</IfModule>

# Hostinger/Apache environment variable example. Keep real credentials out of git.
# Prefer a private .env file or ignored local config files for secrets.
# SetEnv SUPABASE_DB_HOST "db.your-project-ref.supabase.co"
# SetEnv SUPABASE_DB_PORT "5432"
# SetEnv SUPABASE_DB_NAME "postgres"
# SetEnv SUPABASE_DB_USER "postgres"
# SetEnv SUPABASE_DB_PASS "paste-database-password-on-server-only"
# SetEnv SUPABASE_DB_SSLMODE "require"
# SetEnv SUPABASE_URL "https://your-project-ref.supabase.co"
# SetEnv SUPABASE_ANON_KEY "publishable-anon-key"
# SetEnv SUPABASE_AUTH_ENABLED "0"
# SetEnv SERVITECH_DB_ENFORCE_RLS "0"
# SetEnv SERVITECH_PRIVATE_UPLOAD_DIR "/home/your-hostinger-user/ServiTech_Uploads"
# SetEnv SERVITECH_REQUIRE_PRIVATE_UPLOAD_ROOT "1"
# SetEnv APP_DEBUG "0"
# SetEnv SMTP_HOST "smtp.gmail.com"
# SetEnv SMTP_PORT "587"
# SetEnv SMTP_SECURE "tls"
# SetEnv SMTP_USERNAME "REPLACE_WITH_NEW_GOOGLE_ACCOUNT@gmail.com"
# SetEnv SMTP_PASSWORD "paste-gmail-app-password-on-server-only"
# SetEnv SMTP_FROM_EMAIL "REPLACE_WITH_NEW_GOOGLE_ACCOUNT@gmail.com"
# SetEnv SMTP_FROM_NAME "ServiTech"

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^logs(?:/|$) - [F,L]
  RewriteRule ^storage(?:/|$) - [F,L]
  RewriteRule ^uploads(?:/|$) - [F,L]
  RewriteRule ^scripts(?:/|$) - [F,L]
  RewriteRule ^(?:backups|database|docs|supabase|tests|vendor|legacy)(?:/|$) - [F,L]
  RewriteRule ^supabase-audit\.txt$ - [F,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.log$">
  Require all denied
</FilesMatch>

<FilesMatch "^(?:composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|README\.md|PROJECT_STRUCTURE\.md)$">
  Require all denied
</FilesMatch>
